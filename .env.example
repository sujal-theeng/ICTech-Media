# Environment Variables
# Copy this file to .env and fill in your values

# Site URL
VITE_SITE_URL=https://ictechmedia.com

# Google Analytics (replace with your GA4 Measurement ID)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager (replace with your GTM ID)
VITE_GTM_ID=GTM-XXXXXXX

# Contact Form Endpoint (if using external service)
VITE_CONTACT_API_URL=

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/ictechmedia
VITE_LINKEDIN_URL=https://linkedin.com/company/ictechmedia
VITE_TWITTER_URL=https://twitter.com/ictechmedia
