    width: 100%;
    margin-right: 2%;
	}
  .sidebar {
    display: block;
    width: 100%;
    margin: 0 auto;
    float: unset;
	}
  
}

@media only screen and (max-width: 959px) and (min-width: 768px) {
  
 
    aside#mailerlite_widget-2 {
    max-height: 0;
}
aside#custom_html-4 {
    display: none;
    z-index: 100000;
}
  
  aside#custom_html-5_clone,aside#custom_html-4_clone, p#breadcrumbs b {

display: none;

}
  div#footerThree,div#footerOne,div#footerTwo {
    display: inline-block;
    width: 100%;
    margin-top: 15px;
}
  
  .sidebar .widget {
    float: left;
    width: 100%;
    margin-right: 2%;
	}
  .sidebar {
    display: block;
    width: 100%;
    margin: 0 auto;
    float: unset;
	}
  
  
}

@media only screen and (max-width: 679px) {
  div#latest_details {
    width: 65%;
    float: right;
    margin-left: 12px;
	}
	div#latest_thumbnail img {
    border-radius: 8px;
    width: 230px;
    height: 130px;
}
  li#latest_repeat .entry-summary {
    font-size: 15px;
    display: none;
    margin-top: 5px;
	}
  li#latest_repeat .entry-meta {
    display: none;
    font-size: 13px;
	}
  a#latest_title {
    display: inline-block;
    font-size: 16px;
