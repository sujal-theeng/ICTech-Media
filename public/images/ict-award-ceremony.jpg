    margin-bottom: -5px;
}
.pum-theme-53205 .pum-content+.pum-close, .pum-theme-black-bg .pum-content+.pum-close {
    position: absolute;
    height: auto;
    width: auto;
    left: auto;
    right: 0;
    bottom: auto;
    top: 0;
    padding: 8px;
    color: #fff;
    font-family: inherit;
    font-weight: 400;
    font-size: 12px;
    line-height: 30px;
    border: 1px none #fff;
    border-radius: 0;
    box-shadow: 1px 1px 3px 0px rgba(2,2,2,.23);
    text-shadow: 0px 0px 0px rgba(0,0,0,.23);
    background-color: rgba(228,18,18,1);
}
